data/
raw/

# benchmark heavy outputs
benchmark_artifacts_dir/**/dataframes/
benchmark_artifacts_dir/**/checkpoints/

# huge generated files
*.parquet
*.zst

# notebook cache
.ipynb_checkpoints/

# environments
.venv/
env/

# python cache
__pycache__/
